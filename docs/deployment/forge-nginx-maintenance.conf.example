# Optional but strongly recommended for Forge + Nginx.
# Add INSIDE your site's server { } block (adjust paths to your Forge site directory).
#
# When web/.maintenance exists, Nginx serves the static page for EVERY request —
# including /_next/* — without hitting Node during npm run build / pm2 restart.

